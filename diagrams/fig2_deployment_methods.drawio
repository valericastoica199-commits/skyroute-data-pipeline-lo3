<mxfile host="app.diagrams.net"><diagram name="Deployment methods"><mxGraphModel dx="1240" dy="560" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane2" value="A. Manual deployment" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="15" width="1030" height="150" as="geometry"/></mxCell><mxCell id="lane3" value="B. Scheduled deployment - Render Cron Job (render.yaml)" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="190" width="1030" height="160" as="geometry"/></mxCell><mxCell id="lane4" value="C. Serverless deployment - Vercel Function (api/run.py)" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="375" width="1030" height="170" as="geometry"/></mxCell><mxCell id="repo" value="GitHub repository&lt;br&gt;(main branch,&lt;br&gt;tagged releases)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="150" height="80" as="geometry"/></mxCell><mxCell id="m1" value="Engineer runs&lt;br&gt;run_pipeline.bat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="65" width="150" height="60" as="geometry"/></mxCell><mxCell id="m2" value="python src/pipeline.py&lt;br&gt;--workers 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="65" width="160" height="60" as="geometry"/></mxCell><mxCell id="m3" value="Local output/ + logs/&lt;br&gt;checked by engineer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="65" width="170" height="60" as="geometry"/></mxCell><mxCell id="m4" value="Good for: tests, one-off&lt;br&gt;backfills, first release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="65" width="180" height="60" as="geometry"/></mxCell><mxCell id="s1" value="Cron trigger&lt;br&gt;0 2 * * * (UTC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="245" width="150" height="60" as="geometry"/></mxCell><mxCell id="s2" value="Build: pip install&lt;br&gt;+ pytest -q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="245" width="160" height="60" as="geometry"/></mxCell><mxCell id="s3" value="Run container&lt;br&gt;python src/pipeline.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="245" width="170" height="60" as="geometry"/></mxCell><mxCell id="s4" value="Render logs,&lt;br&gt;events &amp; deploy history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="245" width="180" height="60" as="geometry"/></mxCell><mxCell id="v1" value="Vercel Cron 06:00 UTC&lt;br&gt;or HTTPS GET /api/run&lt;br&gt;+ Bearer CRON_SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="430" width="160" height="70" as="geometry"/></mxCell><mxCell id="v2" value="Auth check&lt;br&gt;401 if token wrong" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y=