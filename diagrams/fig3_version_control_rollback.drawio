<mxfile host="app.diagrams.net"><diagram name="Version control, CI and rollback"><mxGraphModel dx="1130" dy="460" grid="1" gridSize="10" page="1" pageWidth="1130" pageHeight="460"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="br" value="Feature branch&lt;br&gt;git checkout -b feature/x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="170" height="60" as="geometry"/></mxCell><mxCell id="pr" value="Commit + pull&lt;br&gt;request (review)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="ci" value="GitHub Actions&lt;br&gt;pytest -v + smoke run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="160" height="60" as="geometry"/></mxCell><mxCell id="ok" value="Tests&lt;br&gt;pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="45" width="110" height="90" as="geometry"/></mxCell><mxCell id="mg" value="Merge to main&lt;br&gt;git tag -a vX.Y.Z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="dp" value="Auto-deploy&lt;br&gt;Render / Vercel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="mon" value="Monitor: dashboard,&lt;br&gt;logs, run_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="150" height="60" as="geometry"/></mxCell><mxCell id="hl" value="Healthy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="195" width="110" height="90" as="geometry"/></mxCell><mxCell id="keep" value="Keep release&lt;br&gt;(last known good)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="150" height="60" as="geometry"/></mxCell><mxCell id="rb1" value="1. Instant rollback&lt;br&gt;to previous deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="360" width="150" height="60" as="geometry"/></mxCell><mxCell id="rb2" value="2. git revert &lt;sha&gt;&lt;br&gt;(new commit, history kept)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="170" height="60" as="geometry"/></mxCell><mxCell id="rb3" value="3. Restore data from&lt;br&gt;last good run artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="170" height="60" as="geometry"/></mxCell><mxCell id="fix" value="Fix on branch +&lt;br&gt;add regression test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="210" width="150" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="br" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr" targe